# AutoTrade — ONE container / V2 Engine + Live Dashboard
# Copy values into your host's Environment UI. Never commit real secrets.
# Full checklist: docs/DEPLOYMENT.md
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-SUPABASE-POOLER:5432/postgres?sslmode=require
BINGX_API_KEY=PUT_TRADE_KEY_HERE
BINGX_API_SECRET=PUT_TRADE_SECRET_HERE
DISCORD_WEBHOOK_BTC=PUT_BTC_CHANNEL_WEBHOOK_HERE
DISCORD_WEBHOOK_ETH=PUT_ETH_CHANNEL_WEBHOOK_HERE
DISCORD_WEBHOOK_ERROR=PUT_ERROR_CHANNEL_WEBHOOK_HERE
BINGX_READ_API_KEY=PUT_SEPARATE_READ_ONLY_KEY_HERE
BINGX_READ_API_SECRET=PUT_SEPARATE_READ_ONLY_SECRET_HERE

# Optional: retain only if this was ALREADY configured.
# DISCORD_RELAY_URL=
# DISCORD_RELAY_TOKEN=
# DASHBOARD_START_AT=
# COLLECTOR_TOKEN=

# Cleanup of owned, confirmed-closed position orders is ON by default.
# The following is ONLY an emergency opt-out, not a normal deploy setting:
# EXIT_CLEANUP_ENABLED=false
