# AutoTrade V2: complete functional deployment (do NOT commit real secrets).
# Providing the three trading credentials below auto-enables LIVE execution.
# Ensure the old BingX writer is stopped before configuring this new service.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-SUPABASE-HOST:5432/postgres?sslmode=require
BINGX_API_KEY=REPLACE_WITH_TRADE_KEY
BINGX_API_SECRET=REPLACE_WITH_TRADE_SECRET

# Required for the BTC, ETH and error notifications.
DISCORD_WEBHOOK_BTC=REPLACE_WITH_BTC_WEBHOOK_URL
DISCORD_WEBHOOK_ETH=REPLACE_WITH_ETH_WEBHOOK_URL
DISCORD_WEBHOOK_ERROR=REPLACE_WITH_ERROR_WEBHOOK_URL

# Preserve only if configured on the previous service:
# DISCORD_RELAY_URL=
# DISCORD_RELAY_TOKEN=
# EXIT_CLEANUP_ENABLED=true
# EMAIL_ALERTS_ENABLED=true
# SMTP_PASSWORD=
# SMTP_USER=
