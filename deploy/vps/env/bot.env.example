# Install as /etc/autotrade/bot.env with mode 0600. Never commit real values.
SYMBOLS=BTC-USDT,ETH-USDT
DATABASE_URL=
BINGX_API_KEY=
BINGX_API_SECRET=
DISCORD_WEBHOOK_BTC=
DISCORD_WEBHOOK_ETH=
DISCORD_WEBHOOK_ERROR=

STATE_DB=/var/lib/autotrade/bot/autotrade_v2.db
BOOTSTRAP_ENABLED=false
WEBSOCKET_ENABLED=true
EXECUTION_ENABLED=false
DRY_RUN=true

# Locked production exit behavior. Do not change during the migration.
TP_TRAILING_SPLIT_ENABLED=true
TP_TRAILING_ACTIVATION_PCT=0.005
TP_TRAILING_CALLBACK_RATE=0.005
EXIT_CLEANUP_ENABLED=true
POSITION_LIFECYCLE_ENABLED=false

DISCORD_ENABLED=true
LOG_LEVEL=INFO

