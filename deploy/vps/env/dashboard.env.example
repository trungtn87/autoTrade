# Install as /etc/autotrade/dashboard.env with mode 0600. Use a read-only BingX key.
DATABASE_URL=
DB_SCHEMA=autotrade_analytics
BINGX_READ_API_KEY=
BINGX_READ_API_SECRET=
BINGX_SYMBOLS=BTC-USDT,ETH-USDT
BINGX_REQUEST_DELAY=0.6

DASHBOARD_PUBLIC_READONLY=false
DASHBOARD_PASSWORD=
APP_SESSION_SECRET=
COOKIE_SECURE=true
DASHBOARD_START_AT=

