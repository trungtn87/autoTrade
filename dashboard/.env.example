# Render dashboard/PWA web service (read-only)
DB_SCHEMA=autotrade_analytics
# Set true to open read-only dashboard without login (public URL exposes trading statistics)
DASHBOARD_PUBLIC_READONLY=true
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DASHBOARD_PASSWORD=SET_A_LONG_UNIQUE_PASSWORD
APP_SESSION_SECRET=GENERATE_RANDOM_64_CHAR_SECRET
COOKIE_SECURE=true
COLLECTOR_TOKEN=GENERATE_RANDOM_64_CHAR_SECRET
# Render scheduled collector (no BingX write permissions)
BINGX_READ_API_KEY=
BINGX_READ_API_SECRET=
BINGX_SYMBOLS=BTC-USDT,ETH-USDT
BINGX_REQUEST_DELAY=0.6
