{
  "standard_version": "1.0",
  "locked_at_utc": "2026-09-21T08:15:00Z",
  "data": {
    "source": "BingX public perpetual futures",
    "timeframe": "15m",
    "timezone": "UTC",
    "range_convention": "[start,end)",
