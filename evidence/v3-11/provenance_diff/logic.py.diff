+class _IncSMA:
+    def __init__(self, n: int):
+        self.n = n
+        self.buf: list[float] = []
+
+    def step(self, x: float) -> float:
+        xf = float(x)
+        self.buf.append(xf)
+        if len(self.buf) > self.n:
+            self.buf.pop(0)
+        if len(self.buf) < self.n or not all(math.isfinite(v) for v in self.buf):
+            return np.nan
+        return sum(self.buf) / self.n
