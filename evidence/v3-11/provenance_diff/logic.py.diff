+class _IncATR:
+    def __init__(self, n: int):
+        self.rma = _IncRMA(n)
+        self.prev_c: float = np.nan
+
+    def step(self, h: float, l: float, c: float) -> float:
+        if math.isnan(self.prev_c):
+            tr = h - l
+        else:
+            tr = max(h - l, abs(h - self.prev_c), abs(l - self.prev_c))
+        self.prev_c = c
+        return self.rma.step(tr)
