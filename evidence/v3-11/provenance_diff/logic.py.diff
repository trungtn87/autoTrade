+        self.l0 = np.nan
+        self.c0 = np.nan
+        self.h_prev1 = np.nan
+        self.h_prev2 = np.nan
+        self.l_prev1 = np.nan
+        self.l_prev2 = np.nan
+        self.bull = True
+        self.af = start
+        self.ep = np.nan
+        self.sar = np.nan
+
+    def step(self, h: float, l: float, c: float) -> float:
+        i = self.idx
+        self.idx += 1
+        if i == 0:
+            self.h0, self.l0, self.c0 = h, l, c
+            self.h_prev1, self.l_prev1 = h, l
+            return np.nan
+        if i == 1:
+            self.bull = c >= self.c0
+            self.af = self.start
+            self.ep = self.h0 if self.bull else self.l0
+            self.sar = self.l0 if self.bull else self.h0
+
+        sar = self.sar + self.af * (self.ep - self.sar)
+        if self.bull:
+            sar = min(sar, self.l_prev1, self.l_prev2) if i >= 2 else min(sar, self.l_prev1)
+            if l < sar:
+                self.bull = False
+                sar = self.ep
+                self.ep = l
+                self.af = self.start
+            elif h > self.ep:
+                self.ep = h
+                self.af = min(self.max_af, self.af + self.inc)
+        else:
+            sar = max(sar, self.h_prev1, self.h_prev2) if i >= 2 else max(sar, self.h_prev1)
+            if h > sar:
+                self.bull = True
+                sar = self.ep
+                self.ep = h
+                self.af = self.start
+            elif l < self.ep:
+                self.ep = l
+                self.af = min(self.max_af, self.af + self.inc)
+
+        self.sar = sar
+        self.h_prev2 = self.h_prev1
+        self.l_prev2 = self.l_prev1
+        self.h_prev1 = h
+        self.l_prev1 = l
+        return sar
