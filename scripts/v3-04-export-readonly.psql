-- V3-04: run ONLY as a dedicated SELECT-only PostgreSQL role via TLS.
-- Execute in a LOCAL export directory; \copy writes CSV to the client PC.
-- NEVER run this using V2 service_role secrets, or commit resulting CSV to Git.
\set ON_ERROR_STOP on
BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;
\copy (SELECT entry_order_id, signal_id, symbol, side, combo, signal_time_ms FROM autotrade_analytics.signal_links ORDER BY signal_time_ms, symbol, signal_id) TO 'signal_links.csv' WITH (FORMAT CSV, HEADER TRUE)
\copy (SELECT order_id, symbol, side, position_side, type, status, filled_qty, quantity, avg_price, price, created_ms, updated_ms FROM autotrade_analytics.bingx_orders ORDER BY created_ms, order_id) TO 'bingx_orders.csv' WITH (FORMAT CSV, HEADER TRUE)
\copy (SELECT trade_id, order_id, symbol, side, position_side, qty, price, fee, realized_pnl, timestamp_ms FROM autotrade_analytics.bingx_fills ORDER BY timestamp_ms, symbol, trade_id) TO 'bingx_fills.csv' WITH (FORMAT CSV, HEADER TRUE)
\copy (SELECT income_key, symbol, income_type, amount, asset, timestamp_ms, trade_id FROM autotrade_analytics.bingx_income ORDER BY timestamp_ms, symbol, income_key) TO 'bingx_income.csv' WITH (FORMAT CSV, HEADER TRUE)
-- Sanitize V2 state payload: only the fields required for exact ownership checks.
-- No raw exchange JSON, personal account, token, API key, Discord or chat payload.
\copy (SELECT event_id, target, jsonb_build_object('exit_mode', payload::jsonb->>'exit_mode', 'position_id', payload::jsonb->>'position_id', 'shared_position', payload::jsonb->'shared_position', 'merged_reconcile', CASE WHEN payload::jsonb ? 'merged_reconcile' THEN jsonb_build_object('shared', payload::jsonb #>> '{merged_reconcile,shared}') ELSE NULL END, 'protection', jsonb_build_object('sl', jsonb_build_object('order_id', payload::jsonb #>> '{protection,sl,order_id}'), 'tp', jsonb_build_object('order_id', payload::jsonb #>> '{protection,tp,order_id}'), 'trailing', jsonb_build_object('order_id', payload::jsonb #>> '{protection,trailing,order_id}')))::text AS payload FROM public.processed_targets WHERE target IN ('bingx_state','bingx_account') ORDER BY event_id, target) TO 'processed_targets.csv' WITH (FORMAT CSV, HEADER TRUE)
COMMIT;
